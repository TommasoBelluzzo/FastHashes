{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Tests: Debug",
      "program": "${workspaceFolder}/Solution/Output/Debug/net10.0/FastHashes.Tests.dll",
      "cwd": "${workspaceFolder}/Solution/Output/Debug/net10.0",
      "args": [
        "-automated"
      ],
      "console": "integratedTerminal",
      "stopAtEntry": true,
      "justMyCode": false,
      "logging": {
        "moduleLoad": true,
        "exceptions": false
      }
    },
    {
      "name": "Run Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Tests: Release",
      "program": "${workspaceFolder}/Solution/Output/Release/net10.0/FastHashes.Tests.dll",
      "cwd": "${workspaceFolder}/Solution/Output/Release/net10.0",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run Analysis",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Analysis: Release",
      "program": "${workspaceFolder}/Solution/Output/Release/net10.0/FastHashes.Analysis.dll",
      "cwd": "${workspaceFolder}/Solution",
      "args": [
        "--hash",
        "FarmHash32",
        "--analysis",
        "distribution"
      ],
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run Benchmarks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Benchmarks: Release",
      "program": "${workspaceFolder}/Solution/Output/Release/net10.0/FastHashes.Benchmarks.dll",
      "cwd": "${workspaceFolder}/Solution",
      "args": [],
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run Coverage",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Tests: Release",
      "program": "${workspaceFolder}/Solution/Output/Release/net10.0/FastHashes.Tests.dll",
      "cwd": "${workspaceFolder}/Solution/Output/Release/net10.0",
      "args": [
        "--coverlet",
        "--coverlet-output-format",
        "cobertura",
        "--coverlet-output-format",
        "json",
        "--coverlet-output-format",
        "lcov",
        "--coverlet-include",
        "[FastHashes]*",
        "--results-directory",
        "${workspaceFolder}/Solution/Coverage",
        "--coverlet-exclude-by-attribute",
        "CompilerGeneratedAttribute",
        "--coverlet-exclude-by-attribute",
        "ExcludeFromCodeCoverageAttribute",
        "--coverlet-exclude-by-attribute",
        "GeneratedCodeAttribute",
        "--coverlet-skip-auto-props"
      ],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": false
    }
  ]
}